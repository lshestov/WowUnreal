{
  "qaClass":1, "qaLevel":1, "qaGm":false, "qaSpawnEntry":823, "qaSpawnOffset":3,
  "width":1280, "height":900,
  "steps":[
    {"op":"wait_world","timeout":140}, {"op":"wait_floor","timeout":80},
    {"op":"time","minutes":630},
    {"op":"lua_wait","condition":"ChatFrame1:IsVisible() and FCFDock_GetSelectedWindow(GENERAL_CHAT_DOCK)==ChatFrame1","timeout":15},
    {"op":"lua","code":"ChatFrame1:SetFading(false); ChatFrame1:Clear(); for i=1,32 do ChatFrame1:AddMessage(string.format('Chat history message %02d',i),1,1,1) end"},
    {"op":"lua_wait","condition":"ChatFrame1:AtBottom() and not ChatFrame1:AtTop() and ChatFrame1:GetCurrentScroll()==0 and ChatFrame1:GetNumLinesDisplayed()>0 and ChatFrame1ButtonFrameUpButton:IsVisible() and ChatFrame1ButtonFrameDownButton:IsVisible() and ChatFrame1ButtonFrameBottomButton:IsVisible() and not ChatFrame1ButtonFrameMinimizeButton:IsShown()","timeout":10},
    {"op":"move_pointer","x":0.6,"y":0.35},
    {"op":"inspect_frame","name":"ChatFrame1ButtonFrameUpButton","label":"scroll-up"},
    {"op":"inspect_frame","name":"ChatFrame1ButtonFrameDownButton","label":"scroll-down"},
    {"op":"inspect_frame","name":"ChatFrame1ButtonFrameBottomButton","label":"scroll-bottom"},
    {"op":"capture","name":"01-chat-buttons-and-recent-history"},
    {"op":"click_frame","name":"ChatFrame1ButtonFrameUpButton"},
    {"op":"lua_wait","condition":"ChatFrame1:GetCurrentScroll()==1 and not ChatFrame1:AtBottom()","timeout":8},
    {"op":"lua_wait","condition":"ChatFrame1ButtonFrameBottomButtonFlash:IsShown()","timeout":5},
    {"op":"capture","name":"02-history-scrolled-up-and-return-indicator"},
    {"op":"click_frame","name":"ChatFrame1ButtonFrameDownButton"},
    {"op":"lua_wait","condition":"ChatFrame1:GetCurrentScroll()==0 and ChatFrame1:AtBottom() and not ChatFrame1ButtonFrameBottomButtonFlash:IsShown()","timeout":8},
    {"op":"click_frame","name":"ChatFrame1ButtonFrameUpButton"},
    {"op":"lua_wait","condition":"ChatFrame1:GetCurrentScroll()==1","timeout":8},
    {"op":"click_frame","name":"ChatFrame1ButtonFrameBottomButton"},
    {"op":"lua_wait","condition":"ChatFrame1:AtBottom() and ChatFrame1:GetCurrentScroll()==0","timeout":8},
    {"op":"click_frame","name":"ChatFrameMenuButton"},
    {"op":"lua_wait","condition":"ChatMenu:IsVisible() and ChatMenuButton1:IsVisible()","timeout":8},
    {"op":"capture","name":"03-chat-menu"},
    {"op":"click_frame","name":"ChatMenuButton1"},
    {"op":"lua_wait","condition":"not ChatMenu:IsVisible() and ChatFrame1EditBox:IsVisible() and ChatFrame1EditBox:GetAttribute('chatType')=='SAY'","timeout":8},
    {"op":"key","name":"Escape"},
    {"op":"lua_wait","condition":"not ChatFrame1EditBox:IsVisible()","timeout":8},
    {"op":"click_frame","name":"FriendsMicroButton"},
    {"op":"lua_wait","condition":"FriendsFrame:IsVisible()","timeout":8},
    {"op":"capture","name":"04-friends-opened-from-chat"},
    {"op":"click_frame","name":"FriendsFrameCloseButton"},
    {"op":"lua_wait","condition":"not FriendsFrame:IsVisible()","timeout":8},
    {"op":"move_pointer","x":0.6,"y":0.35},
    {"op":"wait","seconds":1},
    {"op":"capture","name":"05-chat-controls-returned-to-idle"}
  ]
}
