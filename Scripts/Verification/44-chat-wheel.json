{
  "qaClass":1, "qaLevel":1, "qaGm":false, "qaSpawnEntry":823, "qaSpawnOffset":3,
  "width":1280, "height":900,
  "steps":[
    {"op":"wait_world","timeout":140},
    {"op":"wait_floor","timeout":80},
    {"op":"time","minutes":630},
    {"op":"lua_wait","condition":"ChatFrame1:IsVisible() and GetCVarDefault('chatMouseScroll')=='1' and GetCVarBool('chatMouseScroll') and ChatFrame1:GetScript('OnMouseWheel')","timeout":15},
    {"op":"lua","code":"ChatFrame1:SetFading(false); ChatFrame1:Clear(); for i=1,40 do ChatFrame1:AddMessage(string.format('Mouse wheel history message %02d',i),1,1,1) end; assert(ChatFrame1:AtBottom() and not ChatFrame1:AtTop())"},
    {"op":"hover_frame","name":"ChatFrame1","forWheel":true},
    {"op":"capture","name":"01-chat-at-latest-messages"},
    {"op":"mouse_wheel","delta":1,"expectedZoom":false},
    {"op":"lua_wait","condition":"ChatFrame1:GetCurrentScroll()==1 and not ChatFrame1:AtBottom()","timeout":5},
    {"op":"mouse_wheel","delta":1,"expectedZoom":false},
    {"op":"lua_wait","condition":"ChatFrame1:GetCurrentScroll()==2 and ChatFrame1ButtonFrameBottomButtonFlash:IsShown()","timeout":5},
    {"op":"capture","name":"02-wheel-up-scrolls-chat-without-zoom"},
    {"op":"mouse_wheel","delta":-1,"expectedZoom":false},
    {"op":"lua_wait","condition":"ChatFrame1:GetCurrentScroll()==1","timeout":5},
    {"op":"mouse_wheel","delta":-1,"expectedZoom":false},
    {"op":"lua_wait","condition":"ChatFrame1:GetCurrentScroll()==0 and ChatFrame1:AtBottom() and not ChatFrame1ButtonFrameBottomButtonFlash:IsShown()","timeout":5},
    {"op":"click_frame","name":"ChatFrame2Tab"},
    {"op":"lua_wait","condition":"ChatFrame2:IsVisible() and FCFDock_GetSelectedWindow(GENERAL_CHAT_DOCK)==ChatFrame2 and ChatFrame2:GetScript('OnMouseWheel')","timeout":5},
    {"op":"lua","code":"ChatFrame2:SetFading(false); ChatFrame2:Clear(); for i=1,40 do ChatFrame2:AddMessage(string.format('Combat log history message %02d',i),1,.82,0) end"},
    {"op":"hover_frame","name":"ChatFrame2","forWheel":true},
    {"op":"mouse_wheel","delta":1,"expectedZoom":false},
    {"op":"lua_wait","condition":"ChatFrame2:GetCurrentScroll()==1 and ChatFrame1:GetCurrentScroll()==0","timeout":5},
    {"op":"capture","name":"03-wheel-scrolls-selected-combat-tab"},
    {"op":"move_pointer","x":0.65,"y":0.38},
    {"op":"mouse_wheel","delta":-1,"expectedZoom":true},
    {"op":"lua","code":"assert(ChatFrame2:GetCurrentScroll()==1,'world wheel must not scroll chat')"},
    {"op":"click_frame","name":"ChatFrame1Tab"},
    {"op":"hover_frame","name":"ChatFrame1","forWheel":true},
    {"op":"mouse_wheel","delta":-1,"expectedZoom":false},
    {"op":"lua","code":"assert(ChatFrame1:AtBottom(),'wheel-down at newest message must stay at bottom')"},
    {"op":"capture","name":"04-chat-bottom-consumes-wheel"}
  ]
}
